{
    "dataRoles": [
        {
            "displayName": "Category",
            "name": "category",
            "kind": "Grouping"
        },
        {
            "displayName": "Measure",
            "name": "measure",
            "kind": "Measure"
        },
        {
            "displayName": "Objetivo / Meta",
            "name": "target",
            "kind": "Measure"
        },
        {
            "displayName": "Anotación",
            "name": "annotation",
            "kind": "Measure"
        }
    ],
    "objects": {
        "xAxis": {
            "properties": {
                "show": { "type": { "bool": true } },
                "fontColor": { "type": { "fill": { "solid": { "color": true } } } },
                "fontSize": { "type": { "numeric": true } },
                "isBold": { "type": { "bool": true } },
                "isItalic": { "type": { "bool": true } },
                "labelAngle": { "type": { "numeric": true } }
            }
        },
        "yAxis": {
            "properties": {
                "showGridlines": { "type": { "bool": true } },
                "gridlineStyle": {
                    "type": {
                        "enumeration": [
                            { "value": "solid", "displayName": "Sólida" },
                            { "value": "dashed", "displayName": "Discontinua" },
                            { "value": "dotted", "displayName": "Punteada" }
                        ]
                    }
                },
                "fontColor": { "type": { "fill": { "solid": { "color": true } } } },
                "fontSize": { "type": { "numeric": true } }
            }
        },
        "columns": {
            "properties": {
                "barColor": { "type": { "fill": { "solid": { "color": true } } } },
                "alternateColors": { "type": { "bool": true } },
                "alternateBarColor": { "type": { "fill": { "solid": { "color": true } } } },
                "padding": { "type": { "numeric": true } }
            }
        },
        "dataLabels": {
            "properties": {
                "show": { "type": { "bool": true } },
                "position": {
                    "type": {
                        "enumeration": [
                            { "value": "outside", "displayName": "Exterior superior" },
                            { "value": "inside", "displayName": "Interior superior" }
                        ]
                    }
                },
                "fontColor": { "type": { "fill": { "solid": { "color": true } } } },
                "fontSize": { "type": { "numeric": true } },
                "isBold": { "type": { "bool": true } },
                "isItalic": { "type": { "bool": true } },
                "showFullNumbers": { "type": { "bool": true } }
            }
        },
        "comparisons": {
            "properties": {
                "show": { "type": { "bool": true } },
                "positiveColor": { "type": { "fill": { "solid": { "color": true } } } },
                "negativeColor": { "type": { "fill": { "solid": { "color": true } } } },
                "lineThickness": { "type": { "numeric": true } },
                "lineStyle": {
                    "type": {
                        "enumeration": [
                            { "value": "solid", "displayName": "Sólida" },
                            { "value": "dashed", "displayName": "Discontinua" },
                            { "value": "dotted", "displayName": "Punteada" }
                        ]
                    }
                },
                "symbolStyle": {
                    "type": {
                        "enumeration": [
                            { "value": "arrows", "displayName": "▲ / ▼" },
                            { "value": "signs", "displayName": "+ / -" },
                            { "value": "arrows_thin", "displayName": "↑ / ↓" }
                        ]
                    }
                },
                "showAbsoluteDiff": { "type": { "bool": true } }
            }
        },
        "targetLine": {
            "properties": {
                "show": { "type": { "bool": true } },
                "fixedValue": { "type": { "numeric": true } },
                "lineColor": { "type": { "fill": { "solid": { "color": true } } } },
                "lineThickness": { "type": { "numeric": true } },
                "lineStyle": {
                    "type": {
                        "enumeration": [
                            { "value": "solid", "displayName": "Sólida" },
                            { "value": "dashed", "displayName": "Discontinua" },
                            { "value": "dotted", "displayName": "Punteada" }
                        ]
                    }
                },
                "showCompliancePct": { "type": { "bool": true } },
                "complianceFontSize": { "type": { "numeric": true } },
                "conditionalLabels": { "type": { "bool": true } },
                "aboveTargetColor": { "type": { "fill": { "solid": { "color": true } } } },
                "belowTargetColor": { "type": { "fill": { "solid": { "color": true } } } },
                "showConditionalIcon": { "type": { "bool": true } }
            }
        },
        "ranking": {
            "properties": {
                "show": { "type": { "bool": true } },
                "fontColor": { "type": { "fill": { "solid": { "color": true } } } },
                "fontSize": { "type": { "numeric": true } },
                "badgeColor": { "type": { "fill": { "solid": { "color": true } } } }
            }
        },
        "alertZone": {
            "properties": {
                "show": { "type": { "bool": true } },
                "threshold": { "type": { "numeric": true } },
                "fillColor": { "type": { "fill": { "solid": { "color": true } } } },
                "fillOpacity": { "type": { "numeric": true } },
                "aboveThreshold": { "type": { "bool": true } }
            }
        },
        "annotations": {
            "properties": {
                "show": { "type": { "bool": true } },
                "fontColor": { "type": { "fill": { "solid": { "color": true } } } },
                "fontSize": { "type": { "numeric": true } },
                "backgroundColor": { "type": { "fill": { "solid": { "color": true } } } }
            }
        }
    },
    "dataViewMappings": [
        {
            "categorical": {
                "categories": {
                    "for": { "in": "category" },
                    "dataReductionAlgorithm": { "top": {} }
                },
                "values": {
                    "select": [
                        { "bind": { "to": "measure" } },
                        { "bind": { "to": "target" } },
                        { "bind": { "to": "annotation" } }
                    ]
                }
            }
        }
    ],
    "privileges": []
}
