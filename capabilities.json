{
    "dataRoles": [
        {
            "displayName": "Category",
            "name": "category",
            "kind": "Grouping"
        },
        {
            "displayName": "Measure",
            "name": "measure",
            "kind": "Measure"
        }
    ],
    "objects": {
        "xAxis": {
            "properties": {
                "show": { "type": { "bool": true } },
                "fontColor": { "type": { "fill": { "solid": { "color": true } } } },
                "fontSize": { "type": { "numeric": true } },
                "isBold": { "type": { "bool": true } },
                "isItalic": { "type": { "bool": true } },
                "labelAngle": { "type": { "numeric": true } }
            }
        },
        "yAxis": {
            "properties": {
                "showGridlines": { "type": { "bool": true } },
                "gridlineStyle": {
                    "type": {
                        "enumeration": [
                            { "value": "solid", "displayName": "Sólida" },
                            { "value": "dashed", "displayName": "Discontinua" },
                            { "value": "dotted", "displayName": "Punteada" }
                        ]
                    }
                },
                "fontColor": { "type": { "fill": { "solid": { "color": true } } } },
                "fontSize": { "type": { "numeric": true } }
            }
        },
        "columns": {
            "properties": {
                "barColor": { "type": { "fill": { "solid": { "color": true } } } },
                "alternateColors": { "type": { "bool": true } },
                "alternateBarColor": { "type": { "fill": { "solid": { "color": true } } } },
                "padding": { "type": { "numeric": true } }
            }
        },
        "dataLabels": {
            "properties": {
                "show": { "type": { "bool": true } },
                "fontColor": { "type": { "fill": { "solid": { "color": true } } } },
                "fontSize": { "type": { "numeric": true } },
                "isBold": { "type": { "bool": true } },
                "isItalic": { "type": { "bool": true } },
                "showFullNumbers": { "type": { "bool": true } }
            }
        },
        "comparisons": {
            "properties": {
                "show": { "type": { "bool": true } },
                "positiveColor": { "type": { "fill": { "solid": { "color": true } } } },
                "negativeColor": { "type": { "fill": { "solid": { "color": true } } } },
                "lineThickness": { "type": { "numeric": true } },
                "lineStyle": {
                    "type": {
                        "enumeration": [
                            { "value": "solid", "displayName": "Sólida" },
                            { "value": "dashed", "displayName": "Discontinua" },
                            { "value": "dotted", "displayName": "Punteada" }
                        ]
                    }
                },
                "symbolStyle": {
                    "type": {
                        "enumeration": [
                            { "value": "arrows", "displayName": "▲ / ▼" },
                            { "value": "signs", "displayName": "+ / -" },
                            { "value": "arrows_thin", "displayName": "↑ / ↓" }
                        ]
                    }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "categorical": {
                "categories": {
                    "for": { "in": "category" },
                    "dataReductionAlgorithm": { "top": {} }
                },
                "values": {
                    "select": [{ "bind": { "to": "measure" } }]
                }
            }
        }
    ],
    "privileges": []
}
