{
    "dataRoles": [
        {
            "displayName": "Category",
            "name": "category",
            "kind": "Grouping"
        },
        {
            "displayName": "Measure",
            "name": "measure",
            "kind": "Measure"
        }
    ],
    "objects": {
        "dataPoint": {
            "properties": {
                "barColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "textColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "positiveColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "negativeColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "lineThickness": {
                    "type": {
                        "numeric": true
                    }
                },
                "lineStyle": {
                    "type": {
                        "enumeration": [
                            { "value": "solid", "displayName": "Sólida" },
                            { "value": "dashed", "displayName": "Discontinua" },
                            { "value": "dotted", "displayName": "Punteada" }
                        ]
                    }
                },
                "symbolStyle": {
                    "type": {
                        "enumeration": [
                            { "value": "arrows", "displayName": "▲ / ▼" },
                            { "value": "signs", "displayName": "+ / -" },
                            { "value": "arrows_thin", "displayName": "↑ / ↓" }
                        ]
                    }
                },
                "alternateColors": {
                    "type": {
                        "bool": true
                    }
                },
                "alternateBarColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                },
                "showBrackets": {
                    "type": {
                        "bool": true
                    }
                },
                "fontSize": {
                    "type": {
                        "numeric": true
                    }
                },
                "showFullNumbers": {
                    "type": {
                        "bool": true
                    }
                }
            }
        }
    },
    "dataViewMappings": [
        {
            "categorical": {
                "categories": {
                    "for": { "in": "category" },
                    "dataReductionAlgorithm": { "top": {} }
                },
                "values": {
                    "select": [{ "bind": { "to": "measure" } }]
                }
            }
        }
    ],
    "privileges": []
}
